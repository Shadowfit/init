mysql/*.cnf text eol=lf

# rig 셸 스크립트는 LF 로 고정한다 — 체크아웃에서 CRLF 가 붙으면 재현이 깨진다.
loadtest/**/*.sh text eol=lf

# ai-server 셸 스크립트도 같은 이유로 LF 고정 (#586) — entrypoint.sh 가 CRLF 로 풀리면
# 셰뱅(`#!/bin/bash\r`)이 깨져 컨테이너가 "no such file or directory" 로 즉시 크래시루프에 빠진다.
ai-server/**/*.sh text eol=lf

# Claude Code 훅도 같은 이유로 LF 고정 — Windows 체크아웃에서 CRLF 가 붙으면 훅이
# 조용히 깨지거나(비교 실패) bash 파싱이 어긋난다.
.claude/hooks/**/*.sh text eol=lf

# 백업·복구 스크립트는 운영 호스트(리눅스)에서 돈다 — Windows 체크아웃에서 CRLF 가 붙으면 셰뱅(#!/usr/bin/env bash)이 깨진다.
scripts/backup/*.sh text eol=lf

# 인프라 파일은 리눅스 호스트·CI 에서 쓰인다 — deploy.sh·systemd 유닛·user_data 가 CRLF 로 풀리면
# 셰뱅과 유닛 파싱이 깨진다. Terraform 도 LF 로 통일한다.
infra/** text eol=lf
